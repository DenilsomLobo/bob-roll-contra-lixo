rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /ranking_bob_roll_contra_lixo/{id} {
   allow get: if true;
   allow list: if request.query.limit != null && request.query.limit <= 10;
   allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['name','score','seconds','won','uid','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 16
    && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000
    && request.resource.data.seconds is int && request.resource.data.seconds >= 0 && request.resource.data.seconds <= 86400
    && request.resource.data.won is bool
    && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }
 }
}
